rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAgent() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    // ─── Users Collection ───────────────────────────────────────────────

    match /users/{userId} {
      // Any authenticated user can read user profiles (needed for agent listing, chat)
      // CRITICAL: This must be simple to avoid circular dependency with isAdmin()/isAgent()
      allow read: if isAuthenticated();

      // Users can only create their own document
      allow create: if isAuthenticated() && isOwner(userId);

      // Users can update their own profile
      // Admins can update any profile (but we check role directly to avoid circular dependency)
      allow update: if isOwner(userId) || 
                       (isAuthenticated() && 
                        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Only admins can delete users (check role directly)
      allow delete: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── User Presence Collection ───────────────────────────────────────

    match /userPresence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ─── OTP Collection ─────────────────────────────────────────────────

    match /otps/{otpId} {
      // OTPs must be accessible during the auth flow when the user is NOT yet
      // signed in (credentials are verified then the session is immediately
      // signed out before the OTP write/read happens).
      allow read, write: if true;
    }

    // ─── Applications Collection ────────────────────────────────────────

    match /applications/{applicationId} {
      // Owner can read their own applications
      // Admin can read all applications
      // Assigned agent can read their assigned applications
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      );

      // Only the owner can create an application (userId must match auth uid)
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Admin can update any application (status changes, notes, agent assignment)
      // Assigned agent can update their assigned applications
      // Owner can update their own application (editing before submission)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isAgent() && resource.data.agentId == request.auth.uid)
      );

      // Only admins can delete applications
      allow delete: if isAdmin();
    }

    // ─── Chats Collection ───────────────────────────────────────────────

    match /chats/{chatId} {
      // Participants can read their own chats; admins can read all chats
      // (admin list access is required for getCountFromServer + subscribeToAllChats)
      allow read: if isAuthenticated() && (
                     request.auth.uid in resource.data.participantIds ||
                     isAdmin()
                  );

      // Authenticated users can create chats (they must be a participant)
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participantIds;

      // Participants can update their own chats; admins can update any chat
      allow update: if isAuthenticated() && (
                       request.auth.uid in resource.data.participantIds ||
                       isAdmin()
                    );

      // Only admins can delete chats
      allow delete: if isAdmin();

      // ─── Messages Subcollection ─────────────────────────────────────

      match /messages/{messageId} {
        // Participants can read messages; admins can read all messages
        allow read: if isChatParticipant(chatId) || isAdmin();

        // Only chat participants can create messages (senderId must match)
        allow create: if isChatParticipant(chatId) &&
                         request.resource.data.senderId == request.auth.uid;

        // Participants can update messages (read receipts, soft delete); admins too
        allow update: if isChatParticipant(chatId) || isAdmin();

        // Only admins can hard-delete messages
        allow delete: if isAdmin();
      }
    }

    // ─── Reviews Collection ─────────────────────────────────────────────

    match /reviews/{reviewId} {
      // Reviews are publicly readable
      allow read: if true;

      // Only authenticated users can create reviews (userId must match)
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Only the review author or admin can update/delete
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── Support Queries Collection ─────────────────────────────────────

    match /supportQueries/{queryId} {
      // Owner can read their own queries, admin can read all
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );

      // Only the owner can create (uid must match auth uid)
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;

      // Only admins can update support queries (status changes, responses)
      allow update: if isAdmin();

      // Only admins can delete support queries
      allow delete: if isAdmin();
    }

    // ─── Support Tickets (legacy) ───────────────────────────────────────

    match /support/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Feature Flags ──────────────────────────────────────────────────

    match /featureFlags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── App Configuration ──────────────────────────────────────────────

    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Audit Logs (admin actions) ─────────────────────────────────────

    match /auditLogs/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();

      // Audit logs are created by Cloud Functions or admin actions
      allow create: if isAdmin();

      // Audit logs should never be modified or deleted
      allow update, delete: if false;
    }
  }
}
